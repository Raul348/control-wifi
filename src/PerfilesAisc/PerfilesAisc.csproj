<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Un solo código fuente para Revit 2023, 2024, 2025, 2026 y 2027.
      Revit 2023 / 2024  -> .NET Framework 4.8
      Revit 2025 / 2026  -> .NET 8
      Revit 2027         -> .NET 10
    Compilar:  dotnet build -c Release -p:RevitVersion=2025   (o 2023, 2024, 2026, 2027)
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2023' Or '$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>

    <AssemblyName>PerfilesAisc</AssemblyName>
    <RootNamespace>PerfilesAisc</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="$(RevitVersion) &gt;= 2024">$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>

    <Version>1.0.0</Version>
    <Product>Perfiles AISC para Revit</Product>
    <Description>Catálogo de perfiles de acero AISC con la interfaz de Tekla: árbol, medidas, figura y colocación de vigas y columnas.</Description>

    <BaseOutputPath>bin\</BaseOutputPath>
    <OutputPath>bin\$(Configuration)\Revit$(RevitVersion)\</OutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\Revit$(RevitVersion)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Ensamblados de referencia de la API de Revit (no se copian a la salida). -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PerfilesAisc.Core\PerfilesAisc.Core.csproj" />
    <None Include="PerfilesAisc.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
