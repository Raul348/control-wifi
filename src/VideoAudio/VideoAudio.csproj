<Project Sdk="Microsoft.NET.Sdk">

  <!-- Programa de escritorio para Windows 10 y 11. Usa .NET Framework 4.8, que ya viene con Windows:
       no hay que instalar nada para ejecutarlo. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>VideoAudio</RootNamespace>
    <AssemblyName>VideoAudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Video a Audio</Product>
    <Description>Convierte videos a audio (MP3, M4A, WAV) y los transcribe a texto con Whisper.</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoAudio.Core\VideoAudio.Core.csproj" />
  </ItemGroup>

</Project>
